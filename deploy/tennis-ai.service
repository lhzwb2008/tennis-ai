[Unit]
Description=网球挥拍测评
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/tennis-ai
# 只绑本机，避开 80/8000-9000 等已被占用的端口
ExecStart=/opt/tennis-ai/.venv/bin/uvicorn web.app:app --host 127.0.0.1 --port 27116
Restart=always
RestartSec=4
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
EnvironmentFile=-/opt/tennis-ai/.env

[Install]
WantedBy=multi-user.target
